        <mxCell id="row_wrap" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7a8b99;strokeWidth=2;fontSize=9;fontColor=#7a8b99;labelBackgroundColor=#ffffff;fontStyle=1;" value="">
